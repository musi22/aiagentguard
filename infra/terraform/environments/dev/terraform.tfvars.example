unique_suffix           = "a1b2c3"
image_tag               = "0000000000000000000000000000000000000000"
github_repository       = "your-org/agentguard"
budget_amount           = 100
budget_contact_emails   = ["finops@example.com"]
alert_action_group_email = "operations@example.com"
# Optional owned same-site domains; generated Azure hostnames are used when null.
public_url  = null
web_url     = null
cors_origins = []

# Inject both secret values through TF_VAR_* in CI; never commit them here:
# TF_VAR_database_admin_password
# TF_VAR_payload_encryption_key

# Public startup PostgreSQL is closed unless exact trusted egress IPs are listed.
postgresql_allowed_ips = {
  office = { start_ip = "203.0.113.10", end_ip = "203.0.113.10" }
}
